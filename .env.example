# Web Search Connector Configuration
# Supports SearXNG instances, DuckDuckGo zero-config, or custom aggregators

# Provider: "searxng" (recommended for self-hosted instances) or "duckduckgo" (public fallback)
SEARCH_PROVIDER=searxng

# SearXNG Endpoint URL (Set to your self-hosted or private SearXNG instance)
SEARXNG_URL=http://localhost:8888

# Daemon Service Configuration
HTTP_PORT=8766
HTTP_HOST=0.0.0.0
LOG_LEVEL=info

# Styx Integration
STYX_API_URL=http://host.docker.internal:3000
STYX_ACCESS_KEY=styx-local-dev-key
